# Copy to .env and adjust. Placeholders only - never commit real secrets.

# Local development uses SQLite. For production switch the provider in
# prisma/schema.prisma to "postgresql" and use a PostgreSQL URL, e.g.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/som?schema=public"
DATABASE_URL="file:./dev.db"

# Shows demo credentials on the login page. Defaults to true outside production.
# In production keep this unset/false unless you are deliberately running a demo.
DEMO_MODE="true"

# Seeding is refused when NODE_ENV=production unless this is "true".
ALLOW_DEMO_SEED="false"

# Session lifetime in hours (default 8)
SESSION_HOURS="8"

# Phase 7 (AI Data Assistant) - leave empty to use demo mode
AI_API_KEY=""
